# -----------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
#
# Docker Compose: use service names (kafka, postgres, redis, redis-2, redis-3)
# Running locally outside Docker: use localhost with the mapped ports
# -----------------------------------------------------------------------

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Docker Compose: kafka:9092  |  Local: localhost:9092
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=gotaskq.jobs
KAFKA_CONSUMER_GROUP=gotaskq-workers
KAFKA_CLIENT_ID=gotaskq

# Docker Compose: redis:6379,...  |  Local: localhost:6379,localhost:6380,localhost:6381
REDIS_ADDRESSES=redis:6379,redis-2:6379,redis-3:6379
REDIS_DATABASE=0
REDIS_POOL_SIZE=10

# Docker Compose: postgres:5432  |  Local: localhost:5433
POSTGRES_DSN=postgres://gotaskq:gotaskq@postgres:5432/gotaskq?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MIGRATIONS_PATH=./migrations

WORKER_CONCURRENCY=8
WORKER_QUEUE_SIZE=256
WORKER_SHUTDOWN_TIMEOUT=30s

SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL=1s
SCHEDULER_MAX_CONCURRENT_RUNS=2

METRICS_NAMESPACE=gotaskq
METRICS_SUBSYSTEM=service

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE_NAME=gotaskq
LOG_ENVIRONMENT=development
